# Copy the values you need into your shell. Nothing loads this file automatically.

# replay (default): use saved responses in tests/cassettes/, no model needed
# record: call the real model and save each response
# live: always call the real model
LLM_MODE=replay

# Local model through Ollama (default provider)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# Hosted model: any API with an OpenAI-compatible /chat/completions route
# LLM_PROVIDER=hosted
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=exact-model-version
# LLM_API_KEY=never-commit-this

# Optional: a stronger judge model. Each falls back to the LLM_* value.
# JUDGE_PROVIDER=hosted
# JUDGE_MODEL=
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
